{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DocMorph",
  "version": "0.2.0",
  "identifier": "com.docconverter.desktop",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DocMorph",
        "width": 1100,
        "height": 760,
        "minWidth": 860,
        "minHeight": 600,
        "dragDropEnabled": true,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "办公文档转换与 PDF 工具箱",
    "longDescription": "支持 Office 文档互转（LibreOffice 引擎）与 PDF 合并/拆分/压缩（内置引擎）的桌面应用",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.13"
    }
  }
}
