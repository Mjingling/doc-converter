{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "doc-pet-ep05",
  "version": "0.1.0",
  "identifier": "com.tutorial.docpet.ep05",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5185",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "文档工具箱 EP05",
        "width": 760,
        "height": 560,
        "minWidth": 620,
        "minHeight": 460,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ]
  }
}
