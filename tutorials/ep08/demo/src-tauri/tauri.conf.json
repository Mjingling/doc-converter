{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "doc-pet-ep08",
  "version": "0.1.0",
  "identifier": "com.tutorial.docpet.ep08",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5188",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "文档工具箱 EP08",
        "width": 640,
        "height": 460,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ]
  }
}
